# Copy to .env for local development. Every variable is documented here; never commit .env.
# docker-compose overrides DATABASE_URL / REDIS_URL / SMTP_HOST for containers.

# --- Runtime -------------------------------------------------------------------------------
# local | test | staging | production
ENV=local
LOG_LEVEL=INFO
# true in production (structured JSON logs)
LOG_JSON=false
# optional (D11): Sentry is enabled only if set
SENTRY_DSN=

# --- Hosts (D10: all domains from env; prod: app./api./cdn.quardlink.com) --------------------
APP_URL=http://localhost:5173
API_URL=http://localhost:8000
CDN_URL=http://localhost:8000/cdn
# comma-separated
CORS_ORIGINS=http://localhost:5173
# Frontend build-time variables (Vercel):
VITE_API_URL=http://localhost:8000
VITE_CDN_URL=http://localhost:8000/cdn
# Interface languages offered (comma-separated). English only for now (D22); "en,ar" re-enables Arabic
VITE_UI_LANGUAGES=en
# "Contact us" address on pricing/plan pages
VITE_CONTACT_EMAIL=hello@example.com

# --- Data stores -----------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/app
TEST_DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/app_test
REDIS_URL=redis://localhost:6379/0

# --- Auth ------------------------------------------------------------------------------------
# REQUIRED outside local/test: random, 32+ chars
JWT_SECRET=local-dev-only-jwt-secret-change-me-in-env
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# must be true outside local development
COOKIE_SECURE=false
# usually empty (host-only cookies on api.<domain>)
COOKIE_DOMAIN=
AUTH_RATE_LIMIT_PER_MINUTE=10
# Google sign-in + (Phase 4) Search Console OAuth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Email (D19: Resend in production, SMTP optional, Mailpit locally) -----------------------
# console | smtp | resend
EMAIL_PROVIDER=console
EMAIL_FROM_ADDRESS=no-reply@localhost
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
RESEND_API_KEY=

# --- Operations ------------------------------------------------------------------------------
# operator cost alerts at 80% / 100% of ceilings (D8)
OPS_ALERT_EMAIL=adarshs18400@gmail.com
# true: seed demo org/sites (never runs in production)
SEED_DEMO=false
DEMO_USER_PASSWORD=demo-password-123

# --- Plans / retention (D13, D20) ------------------------------------------------------------
# plan for new orgs; limits editable in DB/admin
DEFAULT_PLAN_CODE=trial
# ~13 months
RETENTION_RAW_AI_ANSWERS_DAYS=395
RETENTION_HTML_SNAPSHOTS_DAYS=90
AI_RUNS_PER_PROMPT=3

# --- AI + data providers (Phase 2+) -----------------------------------------------------------
ANTHROPIC_API_KEY=
# model IDs come from env, never hard-coded
CLAUDE_MODEL_MAIN=
CLAUDE_MODEL_FAST=
OPENAI_API_KEY=
OPENAI_MODEL=
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# PageSpeed Insights + CrUX
GOOGLE_API_KEY=

# --- Platform connectors (Phase 4-5) ---------------------------------------------------------
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
WIX_APP_ID=
WIX_APP_SECRET=
WEBFLOW_CLIENT_ID=
WEBFLOW_CLIENT_SECRET=
SALLA_CLIENT_ID=
SALLA_CLIENT_SECRET=
SALLA_WEBHOOK_SECRET=
ZID_CLIENT_ID=
ZID_CLIENT_SECRET=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
# envelope key for stored third-party credentials (Phase 3)
APP_ENCRYPTION_KEY=

# --- File storage (S3-compatible; MinIO locally) ---------------------------------------------
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=app-files
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio-password
S3_REGION=us-east-1

# --- Payments: deferred to Phase 7 (D20). Moyasar or Tap first, Stripe second. --------------
