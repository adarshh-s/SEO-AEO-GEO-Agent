# Copy to .env for local development. Every variable is documented here; never commit .env.
# docker-compose overrides DATABASE_URL / REDIS_URL / SMTP_HOST for containers.

# --- Runtime -------------------------------------------------------------------------------
ENV=local                              # local | test | staging | production
LOG_LEVEL=INFO
LOG_JSON=false                         # true in production (structured JSON logs)
SENTRY_DSN=                            # optional (D11): Sentry is enabled only if set

# --- Hosts (D10: all domains from env; prod: app./api./cdn.quardlink.com) --------------------
APP_URL=http://localhost:5173
API_URL=http://localhost:8000
CDN_URL=http://localhost:8000/cdn
CORS_ORIGINS=http://localhost:5173     # comma-separated
# Frontend build-time variables (Vercel):
VITE_API_URL=http://localhost:8000
VITE_CDN_URL=http://localhost:8000/cdn
VITE_CONTACT_EMAIL=hello@example.com   # "Contact us" address on pricing/plan pages

# --- Data stores -----------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/app
TEST_DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/app_test
REDIS_URL=redis://localhost:6379/0

# --- Auth ------------------------------------------------------------------------------------
JWT_SECRET=local-dev-only-jwt-secret-change-me-in-env  # REQUIRED outside local/test: random, 32+ chars
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false                    # must be true outside local development
COOKIE_DOMAIN=                         # usually empty (host-only cookies on api.<domain>)
AUTH_RATE_LIMIT_PER_MINUTE=10
GOOGLE_OAUTH_CLIENT_ID=                # Google sign-in + (Phase 4) Search Console OAuth
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Email (D19: Resend in production, SMTP optional, Mailpit locally) -----------------------
EMAIL_PROVIDER=console                 # console | smtp | resend
EMAIL_FROM_ADDRESS=no-reply@localhost
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
RESEND_API_KEY=

# --- Operations ------------------------------------------------------------------------------
OPS_ALERT_EMAIL=adarshs18400@gmail.com # operator cost alerts at 80% / 100% of ceilings (D8)
SEED_DEMO=false                        # true: seed demo org/sites (never runs in production)
DEMO_USER_PASSWORD=demo-password-123

# --- Plans / retention (D13, D20) ------------------------------------------------------------
DEFAULT_PLAN_CODE=trial                # plan for new orgs; limits editable in DB/admin
RETENTION_RAW_AI_ANSWERS_DAYS=395      # ~13 months
RETENTION_HTML_SNAPSHOTS_DAYS=90
AI_RUNS_PER_PROMPT=3

# --- AI + data providers (Phase 2+) -----------------------------------------------------------
ANTHROPIC_API_KEY=
CLAUDE_MODEL_MAIN=                     # model IDs come from env, never hard-coded
CLAUDE_MODEL_FAST=
OPENAI_API_KEY=
OPENAI_MODEL=
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
GOOGLE_API_KEY=                        # PageSpeed Insights + CrUX

# --- Platform connectors (Phase 4-5) ---------------------------------------------------------
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
WIX_APP_ID=
WIX_APP_SECRET=
WEBFLOW_CLIENT_ID=
WEBFLOW_CLIENT_SECRET=
SALLA_CLIENT_ID=
SALLA_CLIENT_SECRET=
SALLA_WEBHOOK_SECRET=
ZID_CLIENT_ID=
ZID_CLIENT_SECRET=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
APP_ENCRYPTION_KEY=                    # envelope key for stored third-party credentials (Phase 3)

# --- File storage (S3-compatible; MinIO locally) ---------------------------------------------
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=app-files
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio-password
S3_REGION=us-east-1

# --- Payments: deferred to Phase 7 (D20). Moyasar or Tap first, Stripe second. --------------
